# off-host backup staging (models/data_parquets/extras/figures; see MANIFEST.txt)
subsolver_backup/
subsolver_backup1/
# subsolver artifacts too large or too numerous for git. The merged checkpoints
# under experiments/subsolver/ckpts are ~156GB and the eval dumps carry full
# traces; both are staged off-host instead (see MANIFEST.txt). Figures are NOT
# ignored — the ones worth keeping are committed by hand.
experiments/subsolver/ckpts/
experiments/subsolver/dump_save/
subsolver_sft/

# subsolver_logs: in this checkout a symlink to ../verl_origin/subsolver_logs (shared
# run chains, server logs, eval dumps; plotting scripts are versioned in verl_origin).
/subsolver_logs

# subsolver: stray / large local artifacts (not for VCS)
/model.pkl
/vectorizer.pkl
/input.txt
/figures/
/bench_test_artifacts/
/experiments/subsolver/data/
/experiments/subsolver/chains/

# verl-recent port (2026-10-28): symlinks into ../verl_origin for data, checkpoints,
# serving venvs and stray local dirs. Only the links themselves are ignored.
/data
/checkpoints
/tools
/.venv-bcbgrade
/.venv-gemma
/.venv-gemma-fa4
/.venv-q35
/.venv-serve35
# trailing-slash patterns above match real dirs only; the same paths are symlinks here
/bench_test_artifacts
/figures
/subsolver_backup
/subsolver_backup1
/experiments/subsolver/ckpts
/experiments/subsolver/data
